# Database
DATABASE_SSL=false

# Cookies (use none only if client and API are on different sites; needs HTTPS)
COOKIE_SAME_SITE=lax

# Email (leave SMTP_HOST empty in dev: links are printed to the server console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=YouTube Clone <no-reply@localhost>

# Logging: error | warn | info | debug
LOG_LEVEL=debug